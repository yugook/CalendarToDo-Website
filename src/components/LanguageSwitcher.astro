---
import { LOCALE_PATHS } from '../config/site';
import { locales, type Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  label: string;
  paths?: Record<Locale, string>;
}

const { locale, label, paths = LOCALE_PATHS } = Astro.props;
const localeLabels = {
  ja: '日本語',
  en: 'English',
} as const satisfies Record<Locale, string>;
---

<nav class="language-switcher" aria-label={label}>
  <ul>
    {
      locales.map((option) => (
        <li>
          {option === locale ? (
            <span lang={option} aria-current="page">
              {localeLabels[option]}
            </span>
          ) : (
            <a
              href={paths[option]}
              lang={option}
              hreflang={option}
              data-language-switch-link
            >
              {localeLabels[option]}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>

<script>
  import '../scripts/preserve-language-position';
</script>
