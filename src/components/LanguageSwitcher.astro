---
import { LOCALE_PATHS } from '../config/site';
import { locales, type Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  label: string;
}

const { locale, label } = Astro.props;
const localeLabels = {
  ja: '日本語',
  en: 'English',
} as const satisfies Record<Locale, string>;
---

<nav class="language-switcher" aria-label={label}>
  <ul>
    {
      locales.map((option) => (
        <li>
          {option === locale ? (
            <span lang={option} aria-current="page">
              {localeLabels[option]}
            </span>
          ) : (
            <a href={LOCALE_PATHS[option]} lang={option} hreflang={option}>
              {localeLabels[option]}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
