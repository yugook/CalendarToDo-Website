---
import {
  APP_STORE_URLS,
  LEGAL_PATHS,
  LOCALE_PATHS,
  SOCIAL_LINKS,
  SUPPORT_PATHS,
} from '../config/site';
import type { HomeContent, Locale } from '../i18n/types';

interface Props {
  locale: Locale;
  content: HomeContent;
}

const { locale, content } = Astro.props;
const currentYear = new Date().getFullYear();
const homePath = LOCALE_PATHS[locale];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href={LOCALE_PATHS[locale]} aria-label={content.navigation.homeLabel}>
        Calendar ToDo
      </a>
      <p>{content.footer.tagline}</p>
      <nav class="footer-socials" aria-label={content.social.navigationLabel}>
        <a
          class="footer-social-link"
          href={SOCIAL_LINKS.instagram}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={content.social.instagramLabel}
          title={content.social.instagramLabel}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle class="footer-social-icon-dot" cx="17.5" cy="6.5" r="1.25" />
          </svg>
        </a>
        <a
          class="footer-social-link"
          href={SOCIAL_LINKS.github}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={content.social.githubLabel}
          title={content.social.githubLabel}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path
              fill="currentColor"
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.084-.73.084-.73 1.205.084 1.84 1.237 1.84 1.237 1.07 1.835 2.809 1.305 3.495.998.108-.776.418-1.305.762-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.957-.266 1.98-.399 3-.405 1.02.006 2.043.139 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.435.375.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
            />
          </svg>
        </a>
      </nav>
    </div>

    <nav aria-label={content.navigation.footerLabel}>
      <ul class="footer-links">
        <li><a href={`${homePath}#features`}>{content.navigation.features}</a></li>
        <li><a href={`${homePath}#privacy`}>{content.navigation.privacy}</a></li>
        <li><a href={`${homePath}#developer`}>{content.navigation.developer}</a></li>
        <li><a href={SUPPORT_PATHS[locale]}>{content.navigation.support}</a></li>
        <li><a href={LEGAL_PATHS.terms[locale]}>{content.navigation.terms}</a></li>
        <li>
          <a href={LEGAL_PATHS.privacy[locale]}>
            {content.navigation.privacyPolicy}
          </a>
        </li>
        <li>
          <a
            href={APP_STORE_URLS[locale]}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={content.store.ariaLabel}
          >
            App Store ↗
          </a>
        </li>
      </ul>
    </nav>

    <p class="copyright">© {currentYear} Calendar ToDo</p>
  </div>
</footer>
